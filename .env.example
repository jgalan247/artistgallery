# Database
DATABASE_URL="postgresql://user:password@localhost:5432/artistgallery?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# SumUp OAuth
SUMUP_CLIENT_ID="your-sumup-client-id"
SUMUP_CLIENT_SECRET="your-sumup-client-secret"
SUMUP_REDIRECT_URI="http://localhost:3000/api/auth/sumup"
SUMUP_MERCHANT_EMAIL="your-merchant-email@example.com"
SUMUP_MERCHANT_CODE="your-merchant-code"
SUMUP_REFRESH_TOKEN="your-refresh-token-after-oauth"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Artist Gallery <noreply@artistgallery.com>"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
